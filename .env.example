# Kimi（Moonshot AI，OpenAI 兼容接口）
# 真实 key 只写本地 .env（已被 .gitignore 排除），本文件只放占位。
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=sk-xxxx
# 全链路默认同一个便宜快模型；实测分层后再单独配 LLM_MODEL_STRONG（裁判/解说）。
# 注意：可用模型名以实测为准——本队账号 moonshot-v1 裸名 404，v1-auto / kimi-k2-0711-preview 可用。
LLM_MODEL=moonshot-v1-auto
# LLM_MODEL_STRONG=kimi-k2-0711-preview

# 耗时治理（秒）
# 单次 completion 上限；整次 Agent 调用墙钟总预算必须 < ENGINE_TIMEOUT（默认 12s），
# agents 才能先给出确定响应，engine 留 2s 余量永远不等超时。
LLM_TIMEOUT=11
AGENT_TOTAL_BUDGET=10
AGENT_MAX_ROUNDS=3
# 输出长度上限（按角色，tokens）
# MAX_TOKENS_JUDGE=512
# MAX_TOKENS_CREATIVE=1024
# MAX_TOKENS_REWRITE=256
# Kimi 支持 function calling 与 json_schema，保持默认即可；平台不支持时置 0 走兜底。
# TOOL_CALLING_SUPPORTED=1
# STRUCTURED_OUTPUT_SUPPORTED=1

# 语义层 Embedding（EMBED_OFFLINE=1 时无 Key 也能用确定性伪向量跑通全链路）
EMBED_MODEL=text-embedding-3-small
EMBED_OFFLINE=1
EMBED_TIMEOUT=10

# 服务互联（本地开发默认值，一般不用改）
AGENTS_URL=http://localhost:8002
SEMANTIC_URL=http://localhost:8003
