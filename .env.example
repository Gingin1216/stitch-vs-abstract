# 看山工作台（OpenAI 兼容接口）
LLM_BASE_URL=https://your-kanshan-endpoint/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=fast-model-name            # 发牌/压缩用快模型
LLM_MODEL_STRONG=flagship-model-name # 裁判/解说用旗舰模型
EMBED_MODEL=embedding-model-name
EMBED_OFFLINE=1                     # 语义降级：1=无Key/异常降级伪向量（默认），0=上抛 AGENT_TIMEOUT
EMBED_TIMEOUT=10                    # Embedding 接口超时秒数

# 服务互联（本地开发默认值，一般不用改）
AGENTS_URL=http://localhost:8002
SEMANTIC_URL=http://localhost:8003
